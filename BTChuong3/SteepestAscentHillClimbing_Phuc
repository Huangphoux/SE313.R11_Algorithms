#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
using namespace std;
struct TT{
    vector<int> b;
    int gt;
};
int dgia(const vector<int>& b,const vector<int>& mt){
    int sai=0;
    for(int i=0;i<9;++i){
        if(b[i]!=0&&b[i]!=mt[i])sai++;
    }
    return -sai;
}
void inBang(const vector<int>& b){
    for(int i=0;i<9;++i){
        if(b[i]==0)cout<<"_ ";
        else cout<<b[i]<<" ";
        if((i+1)%3==0)cout<<endl;
    }
}
int main(){
    vector<int> mt={1,2,3,8,0,4,7,6,5};
    vector<int> bDau(9);
    cout<<"Nhap cac so tu 1 den 8 va o trong (0). Moi so chi xuat hien mot lan."<<endl;
    for(int i=0;i<9;++i){
        cout<<"Nhap o thu "<<i+1<<" (0-8): ";
        cin>>bDau[i];
    }
    cout<<"\nTRANG THAI BAN DAU:"<<endl;
    inBang(bDau);
    cout<<endl;
    vector<TT> dDi;
    TT hTai={bDau,dgia(bDau,mt)};
    dDi.push_back(hTai);
    bool coTotHon=true;
    while(coTotHon){
        coTotHon=false;
        TT lXongTot=hTai;
        int vt0=-1;
        for(int i=0;i<9;++i){
            if(hTai.b[i]==0){vt0=i;break;}
        }
        int r=vt0/3,c=vt0%3;
        vector<pair<int,int>> huong={{-1,0},{1,0},{0,-1},{0,1}};
        for(const auto& h:huong){
            int rMoi=r+h.first,cMoi=c+h.second;
            if(rMoi>=0&&rMoi<3&&cMoi>=0&&cMoi<3){
                int vtMoi=rMoi*3+cMoi;
                vector<int> bMoi=hTai.b;
                swap(bMoi[vt0],bMoi[vtMoi]);
                int gtMoi=dgia(bMoi,mt);
                if(gtMoi>lXongTot.gt){
                    lXongTot={bMoi,gtMoi};
                    coTotHon=true;
                }
            }
        }
        if(coTotHon){
            hTai=lXongTot;
            dDi.push_back(hTai);
        }
    }
    if(hTai.gt==0){
        cout<<"KET QUA: TIM THAY DICH"<<endl;
    }else{
        cout<<"KET QUA: BI KET TAI CUC DAI CUC BO"<<endl;
    }
    int sBuoc=dDi.size()-1;
    int sTT=dDi.size();
    cout<<"So buoc di: "<<sBuoc<<" | So trang thai: "<<sTT<<endl;
    cout<<"\nDUONG DI (H la so o sai vi tri):"<<endl;
    for(size_t i=0;i<dDi.size();++i){
        cout<<"Buoc "<<i<<" - H="<<-dDi[i].gt<<endl;
        inBang(dDi[i].b);
        if(i<dDi.size()-1){
            cout<<"|"<<endl;
        }
    }
    return 0;
}
